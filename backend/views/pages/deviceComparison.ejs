<%- include("../partials/head", { title: "NETSENTRY - Device Comparison" }) %>

<%- include("../partials/navbar") %>
<%- include("../partials/sidebar") %>

<main class="main-content">

    <!-- Page Header -->
    <div class="page-header">

        <div>
            <h1>Device Comparison</h1>

            <p class="page-description">
                Compare two network configurations and identify security-impacting changes.
            </p>
        </div>

        <div class="page-actions">

            <a href="/drift" class="btn btn-secondary">
                Configuration Drift
            </a>

            <a href="/security-posture" class="btn btn-primary">
                Security Posture
            </a>

        </div>

    </div>


    <!-- Configuration Selection -->
    <section class="card">

        <div class="card-header">

            <div>
                <h2>Compare Devices</h2>

                <p class="card-subtitle">
                    Select two configurations to compare their security posture and configuration changes.
                </p>
            </div>

        </div>


        <form action="/comparison/compare" method="POST">

            <div class="form-grid">

                <!-- Old Configuration -->
                <div class="form-group">

                    <label
                        class="form-label"
                        for="oldConfigurationId"
                    >
                        First Configuration
                    </label>

                    <select
                        class="form-control"
                        id="oldConfigurationId"
                        name="oldConfigurationId"
                        required
                    >

                        <option value="">
                            Select First Configuration
                        </option>

                        <% configurations.forEach(function(config) { %>

                            <option
                                value="<%= config._id %>"
                                <%= oldConfiguration &&
                                    oldConfiguration._id.toString() === config._id.toString()
                                    ? "selected"
                                    : "" %>
                            >
                                <%= config.fileName %>
                                -
                                <%= config.device?.deviceName || "Unknown Device" %>
                            </option>

                        <% }); %>

                    </select>

                </div>


                <!-- New Configuration -->
                <div class="form-group">

                    <label
                        class="form-label"
                        for="newConfigurationId"
                    >
                        Second Configuration
                    </label>

                    <select
                        class="form-control"
                        id="newConfigurationId"
                        name="newConfigurationId"
                        required
                    >

                        <option value="">
                            Select Second Configuration
                        </option>

                        <% configurations.forEach(function(config) { %>

                            <option
                                value="<%= config._id %>"
                                <%= newConfiguration &&
                                    newConfiguration._id.toString() === config._id.toString()
                                    ? "selected"
                                    : "" %>
                            >
                                <%= config.fileName %>
                                -
                                <%= config.device?.deviceName || "Unknown Device" %>
                            </option>

                        <% }); %>

                    </select>

                </div>

            </div>


            <button
                type="submit"
                class="btn btn-primary"
            >
                Compare Configurations
            </button>

        </form>

    </section>


    <% if (result) { %>

    <!-- Comparison Overview -->
    <section class="stats-grid">

        <div class="stat-card">

            <div class="stat-icon">
                🔄
            </div>

            <div class="stat-content">

                <span class="stat-label">
                    Drift Detected
                </span>

                <strong class="stat-value">
                    <%= result.driftDetected ? "Yes" : "No" %>
                </strong>

            </div>

        </div>


        <div class="stat-card">

            <div class="stat-icon">
                📝
            </div>

            <div class="stat-content">

                <span class="stat-label">
                    Changed Lines
                </span>

                <strong class="stat-value">
                    <%= result.changedLines %>
                </strong>

            </div>

        </div>


        <div class="stat-card">

            <div class="stat-icon">
                ⚠️
            </div>

            <div class="stat-content">

                <span class="stat-label">
                    Risk Level
                </span>

                <strong class="stat-value">
                    <%= result.riskLevel %>
                </strong>

            </div>

        </div>


        <div class="stat-card">

            <div class="stat-icon">
                🛡️
            </div>

            <div class="stat-content">

                <span class="stat-label">
                    Security Impact
                </span>

                <strong class="stat-value">
                    <%= result.securityImpact %>
                </strong>

            </div>

        </div>

    </section>


    <!-- Device Comparison -->
    <section class="card">

        <div class="card-header">

            <div>
                <h2>Configuration Comparison</h2>

                <p class="card-subtitle">
                    Details of the selected configurations.
                </p>
            </div>

        </div>


        <div class="comparison-grid">

            <!-- First Device -->
            <div class="comparison-panel">

                <div class="card-header">

                    <div>

                        <h3>
                            First Configuration
                        </h3>

                    </div>

                </div>


                <% if (oldConfiguration) { %>

                    <div class="detail-panel">

                        <div class="detail-row">

                            <span class="detail-label">
                                File Name
                            </span>

                            <strong>
                                <%= oldConfiguration.fileName %>
                            </strong>

                        </div>


                        <div class="detail-row">

                            <span class="detail-label">
                                Device
                            </span>

                            <strong>
                                <%= oldConfiguration.device?.deviceName || "Unknown Device" %>
                            </strong>

                        </div>


                        <div class="detail-row">

                            <span class="detail-label">
                                Vendor
                            </span>

                            <strong>
                                <%= oldConfiguration.device?.vendor || "Unknown" %>
                            </strong>

                        </div>

                    </div>

                <% } %>

            </div>


            <!-- Second Device -->
            <div class="comparison-panel">

                <div class="card-header">

                    <div>

                        <h3>
                            Second Configuration
                        </h3>

                    </div>

                </div>


                <% if (newConfiguration) { %>

                    <div class="detail-panel">

                        <div class="detail-row">

                            <span class="detail-label">
                                File Name
                            </span>

                            <strong>
                                <%= newConfiguration.fileName %>
                            </strong>

                        </div>


                        <div class="detail-row">

                            <span class="detail-label">
                                Device
                            </span>

                            <strong>
                                <%= newConfiguration.device?.deviceName || "Unknown Device" %>
                            </strong>

                        </div>


                        <div class="detail-row">

                            <span class="detail-label">
                                Vendor
                            </span>

                            <strong>
                                <%= newConfiguration.device?.vendor || "Unknown" %>
                            </strong>

                        </div>

                    </div>

                <% } %>

            </div>

        </div>

    </section>


    <!-- Drift Status -->
    <section class="card">

        <div class="card-header">

            <div>

                <h2>Comparison Result</h2>

                <p class="card-subtitle">
                    Summary of configuration differences.
                </p>

            </div>


            <% if (result.driftDetected) { %>

                <span class="badge badge-warning">
                    Changes Detected
                </span>

            <% } else { %>

                <span class="badge badge-success">
                    No Changes
                </span>

            <% } %>

        </div>


        <div class="detail-panel">

            <div class="detail-row">

                <span class="detail-label">
                    Configuration Drift
                </span>

                <strong>
                    <%= result.driftDetected ? "Detected" : "Not Detected" %>
                </strong>

            </div>


            <div class="detail-row">

                <span class="detail-label">
                    Changed Lines
                </span>

                <strong>
                    <%= result.changedLines %>
                </strong>

            </div>


            <div class="detail-row">

                <span class="detail-label">
                    Risk Level
                </span>

                <strong>
                    <%= result.riskLevel %>
                </strong>

            </div>


            <div class="detail-row">

                <span class="detail-label">
                    Security Impact
                </span>

                <strong>
                    <%= result.securityImpact %>
                </strong>

            </div>

        </div>

    </section>


    <!-- Security Impact -->
    <% if (
        result.securityImpact &&
        result.securityImpact !== "None"
    ) { %>

        <section class="card">

            <div class="card-header">

                <div>

                    <h2>Security Impact</h2>

                    <p class="card-subtitle">
                        Security significance of the detected configuration changes.
                    </p>

                </div>

                <span class="badge badge-warning">
                    Security Impact Detected
                </span>

            </div>


            <div class="finding-card">

                <div class="finding-header">

                    <div>

                        <h3>
                            Configuration Security Assessment
                        </h3>

                        <p class="text-muted">
                            The comparison detected changes that may affect the security posture.
                        </p>

                    </div>

                </div>


                <div class="finding-description">

                    <p>
                        <%= result.securityImpact %>
                    </p>

                </div>

            </div>

        </section>

    <% } else { %>

        <section class="card">

            <div class="card-header">

                <div>

                    <h2>Security Impact</h2>

                    <p class="card-subtitle">
                        Security assessment of the configuration differences.
                    </p>

                </div>

                <span class="badge badge-success">
                    No Security Impact
                </span>

            </div>


            <div class="empty-state">

                <div class="empty-state-icon">
                    ✓
                </div>

                <h3>
                    No Security Impact Detected
                </h3>

                <p>
                    The detected configuration changes do not currently indicate a security impact.
                </p>

            </div>

        </section>

    <% } %>


    <!-- Added Lines -->
    <section class="card">

        <div class="card-header">

            <div>

                <h2>Added Configuration</h2>

                <p class="card-subtitle">
                    Configuration lines present in the second configuration.
                </p>

            </div>

            <span class="badge badge-success">
                <%= result.added.length %>
            </span>

        </div>


        <% if (result.added.length > 0) { %>

            <div class="code-block">

                <% result.added.forEach(function(line) { %>

                    <div class="code-line code-added">

                        <span class="code-prefix">
                            +
                        </span>

                        <span>
                            <%= line %>
                        </span>

                    </div>

                <% }); %>

            </div>

        <% } else { %>

            <div class="empty-state">

                <h3>
                    No Added Configuration
                </h3>

                <p>
                    No new configuration lines were detected.
                </p>

            </div>

        <% } %>

    </section>


    <!-- Removed Lines -->
    <section class="card">

        <div class="card-header">

            <div>

                <h2>Removed Configuration</h2>

                <p class="card-subtitle">
                    Configuration lines present in the first configuration but missing from the second.
                </p>

            </div>

            <span class="badge badge-danger">
                <%= result.removed.length %>
            </span>

        </div>


        <% if (result.removed.length > 0) { %>

            <div class="code-block">

                <% result.removed.forEach(function(line) { %>

                    <div class="code-line code-removed">

                        <span class="code-prefix">
                            −
                        </span>

                        <span>
                            <%= line %>
                        </span>

                    </div>

                <% }); %>

            </div>

        <% } else { %>

            <div class="empty-state">

                <h3>
                    No Removed Configuration
                </h3>

                <p>
                    No configuration lines were removed.
                </p>

            </div>

        <% } %>

    </section>


    <% } else { %>

    <!-- Initial State -->
    <section class="card">

        <div class="empty-state">

            <div class="empty-state-icon">
                ⇄
            </div>

            <h2>
                Ready for Device Comparison
            </h2>

            <p>
                Select two configurations above to compare their
                contents, detect drift, and identify security-impacting changes.
            </p>

        </div>

    </section>

    <% } %>


    <!-- Quick Actions -->
    <section class="card">

        <div class="card-header">

            <div>

                <h2>Quick Actions</h2>

                <p class="card-subtitle">
                    Continue your security analysis workflow.
                </p>

            </div>

        </div>


        <div class="quick-actions">

            <a href="/dashboard" class="btn btn-secondary">
                Dashboard
            </a>

            <a href="/configurations" class="btn btn-secondary">
                Configurations
            </a>

            <a href="/configurations/upload" class="btn btn-primary">
                Upload Configuration
            </a>

            <a href="/drift" class="btn btn-secondary">
                Configuration Drift
            </a>

            <a href="/security-posture" class="btn btn-secondary">
                Security Posture
            </a>

            <a href="/risk" class="btn btn-secondary">
                Risk Prioritization
            </a>

            <a href="/exposure" class="btn btn-secondary">
                Exposure Analysis
            </a>

        </div>

    </section>

</main>

<%- include("../partials/footer") %>