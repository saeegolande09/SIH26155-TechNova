<%- include("../partials/head", { title: "Configurations - NETSENTRY" }) %>

<%- include("../partials/navbar") %>

<%- include("../partials/sidebar") %>

<main class="main-content configurations-page">

    <!-- =========================================
         PAGE HEADER
         ========================================= -->

    <div class="page-header">

        <div>

            <h1 class="page-title">
                Configurations
            </h1>

            <p class="page-subtitle">
                Manage and review uploaded network configurations.
            </p>

        </div>

        <a
            href="/configurations/upload"
            class="btn btn-primary"
        >
            + Upload Configuration
        </a>

    </div>


    <%- include("../partials/flash") %>


    <!-- =========================================
         CONFIGURATION LIST
         ========================================= -->

    <section class="content-section">

        <div class="section-heading">

            <div>

                <h2>
                    Uploaded Configurations
                </h2>

                <p>
                    Network configuration files available for security auditing.
                </p>

            </div>

            <span class="record-count">
                <%= configurations ? configurations.length : 0 %>
                Configurations
            </span>

        </div>


        <% if (!configurations || configurations.length === 0) { %>

            <!-- =================================
                 EMPTY STATE
                 ================================= -->

            <div class="empty-state card">

                <div class="empty-state-icon">
                    📁
                </div>

                <h3>
                    No Configurations Uploaded
                </h3>

                <p>
                    Upload a network configuration to begin
                    security analysis and compliance auditing.
                </p>

                <a
                    href="/configurations/upload"
                    class="btn btn-primary"
                >
                    Upload Configuration
                </a>

            </div>


        <% } else { %>


            <!-- =================================
                 CONFIGURATION TABLE
                 ================================= -->

            <div class="table-card">

                <div class="table-wrapper">

                    <table class="data-table">

                        <thead>

                            <tr>

                                <th>
                                    Device
                                </th>

                                <th>
                                    Vendor
                                </th>

                                <th>
                                    File Name
                                </th>

                                <th>
                                    Version
                                </th>

                                <th>
                                    Status
                                </th>

                                <th>
                                    Uploaded At
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            <% configurations.forEach(configuration => { %>

                                <tr>

                                    <!-- DEVICE -->

                                    <td>

                                        <div class="table-primary">

                                            <span class="table-icon">
                                                🖥
                                            </span>

                                            <strong>

                                                <%= configuration.device
                                                    ? configuration.device.deviceName
                                                    : "Unknown Device" %>

                                            </strong>

                                        </div>

                                    </td>


                                    <!-- VENDOR -->

                                    <td>

                                        <span
                                            class="vendor-badge vendor-<%= String(configuration.vendor || '').toLowerCase() %>"
                                        >
                                            <%= configuration.vendor %>
                                        </span>

                                    </td>


                                    <!-- FILE NAME -->

                                    <td>

                                        <span
                                            class="file-name"
                                            title="<%= configuration.fileName %>"
                                        >
                                            <%= configuration.fileName %>
                                        </span>

                                    </td>


                                    <!-- VERSION -->

                                    <td>

                                        <span class="version-badge">
                                            v<%= configuration.configVersion %>
                                        </span>

                                    </td>


                                    <!-- STATUS -->

                                    <td>

                                        <%
                                            let statusClass = "status-neutral";

                                            if (configuration.status === "Completed") {
                                                statusClass = "status-success";
                                            } else if (
                                                configuration.status === "Pending" ||
                                                configuration.status === "Processing"
                                            ) {
                                                statusClass = "status-warning";
                                            } else if (
                                                configuration.status === "Failed"
                                            ) {
                                                statusClass = "status-danger";
                                            }
                                        %>

                                        <span
                                            class="status-badge <%= statusClass %>"
                                        >
                                            <%= configuration.status %>
                                        </span>

                                    </td>


                                    <!-- UPLOADED AT -->

                                    <td>

                                        <span class="date-text">

                                            <%= configuration.uploadedAt
                                                ? new Date(configuration.uploadedAt).toLocaleString()
                                                : "N/A" %>

                                        </span>

                                    </td>

                                </tr>

                            <% }) %>

                        </tbody>

                    </table>

                </div>

            </div>


        <% } %>

    </section>


    <!-- =========================================
         QUICK ACTIONS
         ========================================= -->

    <section class="content-section">

        <div class="section-heading">

            <div>

                <h2>
                    Quick Actions
                </h2>

                <p>
                    Continue working with your network security data.
                </p>

            </div>

        </div>


        <div class="quick-actions-grid">


            <!-- UPLOAD -->

            <a
                href="/configurations/upload"
                class="quick-action-card"
            >

                <span class="quick-action-icon">
                    ↑
                </span>

                <span class="quick-action-content">

                    <strong>
                        Upload Configuration
                    </strong>

                    <small>
                        Add a new network configuration
                    </small>

                </span>

                <span class="quick-action-arrow">
                    →
                </span>

            </a>


            <!-- COMPARISON -->

            <a
                href="/comparison"
                class="quick-action-card"
            >

                <span class="quick-action-icon">
                    ⇄
                </span>

                <span class="quick-action-content">

                    <strong>
                        Compare Configurations
                    </strong>

                    <small>
                        Compare device configurations
                    </small>

                </span>

                <span class="quick-action-arrow">
                    →
                </span>

            </a>


            <!-- EXPOSURE -->

            <a
                href="/exposure"
                class="quick-action-card"
            >

                <span class="quick-action-icon">
                    ◎
                </span>

                <span class="quick-action-content">

                    <strong>
                        Exposure Analysis
                    </strong>

                    <small>
                        Analyze network exposure
                    </small>

                </span>

                <span class="quick-action-arrow">
                    →
                </span>

            </a>


            <!-- RISK -->

            <a
                href="/risk"
                class="quick-action-card"
            >

                <span class="quick-action-icon">
                    △
                </span>

                <span class="quick-action-content">

                    <strong>
                        Risk Prioritization
                    </strong>

                    <small>
                        Prioritize security risks
                    </small>

                </span>

                <span class="quick-action-arrow">
                    →
                </span>

            </a>


            <!-- DRIFT -->

            <a
                href="/drift"
                class="quick-action-card"
            >

                <span class="quick-action-icon">
                    ↻
                </span>

                <span class="quick-action-content">

                    <strong>
                        Configuration Drift
                    </strong>

                    <small>
                        Detect configuration changes
                    </small>

                </span>

                <span class="quick-action-arrow">
                    →
                </span>

            </a>


            <!-- REPORTS -->

            <a
                href="/reports"
                class="quick-action-card"
            >

                <span class="quick-action-icon">
                    ▤
                </span>

                <span class="quick-action-content">

                    <strong>
                        Reports
                    </strong>

                    <small>
                        View security audit reports
                    </small>

                </span>

                <span class="quick-action-arrow">
                    →
                </span>

            </a>

        </div>

    </section>

</main>

<%- include("../partials/footer") %>