<%- include("../partials/head", { title: "Reports - NETSENTRY" }) %>

<%- include("../partials/navbar") %>
<%- include("../partials/sidebar") %>

<main class="main-content">

    <!-- PAGE HEADER -->
    <div class="page-header">

        <div>
            <h1 class="page-title">
                Security Reports
            </h1>

            <p class="page-subtitle">
                Generate, view, and download network security audit reports.
            </p>
        </div>

    </div>


    <%- include("../partials/flash") %>


    <!-- GENERATE REPORT -->
    <section class="content-section">

        <div class="card">

            <div class="card-header">

                <div>
                    <h2>
                        Generate Security Report
                    </h2>

                    <p class="card-subtitle">
                        Select a completed audit to generate a security report.
                    </p>
                </div>

                <span class="badge badge-info">
                    Reporting
                </span>

            </div>


            <form
                action="/reports/generate"
                method="POST"
            >

                <div class="form-group">

                    <label
                        class="form-label"
                        for="auditId"
                    >
                        Select Completed Audit
                    </label>

                    <select
                        class="form-control"
                        id="auditId"
                        name="auditId"
                        required
                    >

                        <option value="">
                            Select Audit
                        </option>

                        <% audits.forEach(function(audit) { %>

                            <option value="<%= audit._id %>">

                                Audit:
                                <%= audit._id %>

                                -

                                <%= audit.device
                                    ? audit.device.deviceName
                                    : "Unknown Device" %>

                                -

                                <%= audit.vendor %>

                                -

                                Score:
                                <%= audit.complianceScore %>%

                            </option>

                        <% }); %>

                    </select>

                    <small class="form-help">
                        Only completed audits should be selected for report generation.
                    </small>

                </div>


                <div class="form-actions">

                    <button
                        type="submit"
                        class="btn btn-primary"
                    >
                        Generate Report
                    </button>

                </div>

            </form>

        </div>

    </section>


    <% if (generatedReport) { %>

    <!-- GENERATED REPORT SUCCESS -->
    <section class="content-section">

        <div class="card">

            <div class="card-header">

                <div>
                    <h2>
                        Report Generated Successfully
                    </h2>

                    <p class="card-subtitle">
                        Your security report has been generated.
                    </p>
                </div>

                <span class="badge badge-success">
                    Generated
                </span>

            </div>


            <div class="detail-grid">

                <div class="detail-item">

                    <span>
                        Report Name
                    </span>

                    <strong>
                        <%= generatedReport.reportName %>
                    </strong>

                </div>


                <div class="detail-item">

                    <span>
                        Compliance Score
                    </span>

                    <strong class="text-primary">
                        <%= generatedReport.complianceScore %>%
                    </strong>

                </div>


                <div class="detail-item">

                    <span>
                        Total Findings
                    </span>

                    <strong>
                        <%= generatedReport.totalFindings %>
                    </strong>

                </div>


                <div class="detail-item">

                    <span>
                        Generated At
                    </span>

                    <strong>
                        <%= generatedReport.generatedAt
                            ? new Date(generatedReport.generatedAt).toLocaleString()
                            : "N/A" %>
                    </strong>

                </div>

            </div>


            <div class="form-actions">

                <a
                    href="/reports/download/<%= generatedReport._id %>"
                    class="btn btn-primary"
                >
                    Download Report
                </a>

            </div>

        </div>

    </section>

    <% } %>


    <!-- GENERATED REPORTS -->
    <section class="content-section">

        <div class="section-heading">

            <div>
                <h2>
                    Generated Reports
                </h2>

                <p>
                    Previously generated security reports.
                </p>
            </div>

        </div>


        <% if (reports && reports.length > 0) { %>

            <div class="report-grid">

                <% reports.forEach(function(report) { %>

                    <div class="card report-card">

                        <div class="card-header">

                            <div>

                                <h3>
                                    <%= report.reportName %>
                                </h3>

                                <p class="card-subtitle">
                                    <%= report.device
                                        ? report.device.deviceName
                                        : "Unknown Device" %>
                                </p>

                            </div>

                            <span class="badge badge-info">
                                Report
                            </span>

                        </div>


                        <div class="detail-grid">

                            <div class="detail-item">

                                <span>
                                    Device
                                </span>

                                <strong>
                                    <%= report.device
                                        ? report.device.deviceName
                                        : "Unknown Device" %>
                                </strong>

                            </div>


                            <div class="detail-item">

                                <span>
                                    Compliance Score
                                </span>

                                <strong class="text-primary">
                                    <%= report.complianceScore %>%
                                </strong>

                            </div>


                            <div class="detail-item">

                                <span>
                                    Total Findings
                                </span>

                                <strong>
                                    <%= report.totalFindings %>
                                </strong>

                            </div>


                            <div class="detail-item">

                                <span>
                                    Generated At
                                </span>

                                <strong>
                                    <%= report.generatedAt
                                        ? new Date(report.generatedAt).toLocaleString()
                                        : "N/A" %>
                                </strong>

                            </div>

                        </div>


                        <% if (report.reportPath) { %>

                            <div class="form-actions">

                                <a
                                    href="/reports/download/<%= report._id %>"
                                    class="btn btn-secondary btn-sm"
                                >
                                    Download Report
                                </a>

                            </div>

                        <% } %>

                    </div>

                <% }); %>

            </div>

        <% } else { %>

            <div class="card">

                <div class="empty-state">

                    <div class="empty-state-icon">
                        📄
                    </div>

                    <h3>
                        No Reports Generated
                    </h3>

                    <p>
                        No reports have been generated yet.
                        Select a completed audit above to create your first report.
                    </p>

                </div>

            </div>

        <% } %>

    </section>


    <!-- QUICK ACTIONS -->
    <section class="content-section">

        <div class="section-heading">

            <div>
                <h2>
                    Quick Actions
                </h2>

                <p>
                    Continue working with NETSENTRY security tools.
                </p>
            </div>

        </div>


        <div class="quick-actions-grid">

            <a
                href="/dashboard"
                class="quick-action-card"
            >
                <span class="quick-action-icon">
                    ⌂
                </span>

                <span class="quick-action-content">
                    <strong>Dashboard</strong>
                    <small>Back to dashboard</small>
                </span>

                <span class="quick-action-arrow">
                    →
                </span>
            </a>


            <a
                href="/audits"
                class="quick-action-card"
            >
                <span class="quick-action-icon">
                    🔍
                </span>

                <span class="quick-action-content">
                    <strong>Audits</strong>
                    <small>View security audits</small>
                </span>

                <span class="quick-action-arrow">
                    →
                </span>
            </a>


            <a
                href="/configurations"
                class="quick-action-card"
            >
                <span class="quick-action-icon">
                    📁
                </span>

                <span class="quick-action-content">
                    <strong>Configurations</strong>
                    <small>View configurations</small>
                </span>

                <span class="quick-action-arrow">
                    →
                </span>
            </a>


            <a
                href="/security-posture"
                class="quick-action-card"
            >
                <span class="quick-action-icon">
                    🛡️
                </span>

                <span class="quick-action-content">
                    <strong>Security Posture</strong>
                    <small>View security posture</small>
                </span>

                <span class="quick-action-arrow">
                    →
                </span>
            </a>


            <a
                href="/risk"
                class="quick-action-card"
            >
                <span class="quick-action-icon">
                    ⚠️
                </span>

                <span class="quick-action-content">
                    <strong>Risk Prioritization</strong>
                    <small>Analyze security risks</small>
                </span>

                <span class="quick-action-arrow">
                    →
                </span>
            </a>

        </div>

    </section>

</main>

<%- include("../partials/footer") %>