<%- include("../partials/head", { title: "AI Training - NETSENTRY" }) %>

<%- include("../partials/navbar") %>

<%- include("../partials/sidebar") %>

<main>

    <h1>
        NETSENTRY - AI Configuration Mapping
    </h1>

    <%- include("../partials/flash") %>

    <hr>

    <h2>
        Analyze Unknown Configuration
    </h2>

    <p>
        Enter a configuration command that is
        not currently recognized by the security
        rule engine.
    </p>

    <form
        action="/ai-training/analyze"
        method="POST"
    >

        <p>
            <label>
                Vendor:
            </label>
            <br>

            <select
                name="vendor"
                required
            >

                <option value="">
                    Select Vendor
                </option>

                <option value="Cisco">
                    Cisco
                </option>

                <option value="Juniper">
                    Juniper
                </option>

                <option value="Fortinet">
                    Fortinet
                </option>

                <option value="Unknown">
                    Unknown
                </option>

            </select>
        </p>

        <p>
            <label>
                Configuration:
            </label>
            <br>

            <textarea
                name="configLine"
                rows="6"
                cols="70"
                placeholder="Enter configuration command..."
                required
            ></textarea>
        </p>

        <button type="submit">
            Analyze Configuration
        </button>

    </form>


    <% if (result) { %>

        <hr>

        <h2>
            AI Configuration Analysis
        </h2>

        <p>
            <strong>Vendor:</strong>
            <%= result.vendor %>
        </p>

        <p>
            <strong>Configuration:</strong>
        </p>

        <pre><%= result.originalConfiguration %></pre>

        <hr>

        <h3>
            Detected Category
        </h3>

        <p>
            <%= result.category %>
        </p>

        <h3>
            Possible Meaning
        </h3>

        <p>
            <%= result.possibleMeaning %>
        </p>

        <h3>
            Risk Level
        </h3>

        <p>
            <%= result.riskLevel %>
        </p>

        <h3>
            Confidence
        </h3>

        <p>
            <%= result.confidence %>%
        </p>

        <h3>
            Suggested Action
        </h3>

        <p>
            <%= result.suggestedAction %>
        </p>

    <% } %>


    <hr>

    <h2>
        Quick Actions
    </h2>

    <p>
        <a href="/dashboard">
            Back to Dashboard
        </a>
    </p>

    <p>
        <a href="/configurations">
            View Configurations
        </a>
    </p>

    <p>
        <a href="/configurations/upload">
            Upload Configuration
        </a>
    </p>

    <p>
        <a href="/security-posture">
            Security Posture
        </a>
    </p>

    <p>
        <a href="/risk">
            Risk Prioritization
        </a>
    </p>

    <p>
        <a href="/exposure">
            Exposure Analysis
        </a>
    </p>

    <p>
        <a href="/reports">
            Reports
        </a>
    </p>

</main>

<%- include("../partials/footer") %>