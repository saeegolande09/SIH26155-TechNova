<%- include("../partials/head", { title: "AI Training - NETSENTRY" }) %>

<%- include("../partials/navbar") %>
<%- include("../partials/sidebar") %>

<main class="main-content">

    <!-- PAGE HEADER -->
    <div class="page-header">

        <div>
            <h1 class="page-title">
                AI Configuration Mapping
            </h1>

            <p class="page-subtitle">
                Analyze unknown network configuration commands using the AI-assisted mapping engine.
            </p>
        </div>

    </div>


    <%- include("../partials/flash") %>


    <!-- AI ANALYSIS FORM -->
    <section class="content-section">

        <div class="card">

            <div class="card-header">

                <div>
                    <h2>
                        Analyze Unknown Configuration
                    </h2>

                    <p class="card-subtitle">
                        Enter a configuration command that is not currently recognized by the security rule engine.
                    </p>
                </div>

                <span class="badge badge-info">
                    AI Assisted
                </span>

            </div>


            <form
                action="/ai-training/analyze"
                method="POST"
            >

                <div class="form-group">

                    <label
                        class="form-label"
                        for="vendor"
                    >
                        Vendor
                    </label>

                    <select
                        class="form-control"
                        id="vendor"
                        name="vendor"
                        required
                    >

                        <option value="">
                            Select Vendor
                        </option>

                        <option value="Cisco">
                            Cisco
                        </option>

                        <option value="Juniper">
                            Juniper
                        </option>

                        <option value="Fortinet">
                            Fortinet
                        </option>

                        <option value="Unknown">
                            Unknown
                        </option>

                    </select>

                </div>


                <div class="form-group">

                    <label
                        class="form-label"
                        for="configLine"
                    >
                        Configuration
                    </label>

                    <textarea
                        class="form-control"
                        id="configLine"
                        name="configLine"
                        rows="7"
                        placeholder="Enter configuration command..."
                        required
                    ></textarea>

                    <small class="form-help">
                        Enter an unknown or unsupported network configuration command.
                    </small>

                </div>


                <div class="form-actions">

                    <button
                        type="submit"
                        class="btn btn-primary"
                    >
                        Analyze Configuration
                    </button>

                </div>

            </form>

        </div>

    </section>


    <% if (result) { %>

    <!-- AI ANALYSIS RESULT -->
    <section class="content-section">

        <div class="card">

            <div class="card-header">

                <div>
                    <h2>
                        AI Configuration Analysis
                    </h2>

                    <p class="card-subtitle">
                        Analysis generated for the submitted configuration.
                    </p>
                </div>

                <span class="badge badge-info">
                    Analysis Complete
                </span>

            </div>


            <!-- BASIC INFORMATION -->
            <div class="detail-grid">

                <div class="detail-item">

                    <span>
                        Vendor
                    </span>

                    <strong>
                        <%= result.vendor %>
                    </strong>

                </div>


                <div class="detail-item">

                    <span>
                        Detected Category
                    </span>

                    <strong>
                        <%= result.category %>
                    </strong>

                </div>


                <div class="detail-item">

                    <span>
                        Risk Level
                    </span>

                    <strong>
                        <%= result.riskLevel %>
                    </strong>

                </div>


                <div class="detail-item">

                    <span>
                        Confidence
                    </span>

                    <strong class="text-primary">
                        <%= result.confidence %>%
                    </strong>

                </div>

            </div>

        </div>


        <!-- ORIGINAL CONFIGURATION -->
        <div class="card">

            <div class="card-header">

                <div>
                    <h2>
                        Original Configuration
                    </h2>

                    <p class="card-subtitle">
                        Configuration command submitted for AI analysis.
                    </p>
                </div>

            </div>


            <div class="code-block">

                <div class="code-line">
                    <span>
                        <%= result.originalConfiguration %>
                    </span>
                </div>

            </div>

        </div>


        <!-- POSSIBLE MEANING -->
        <div class="card">

            <div class="card-header">

                <div>
                    <h2>
                        Possible Meaning
                    </h2>

                    <p class="card-subtitle">
                        AI interpretation of the configuration command.
                    </p>
                </div>

            </div>


            <div class="finding-card">

                <p>
                    <%= result.possibleMeaning %>
                </p>

            </div>

        </div>


        <!-- RISK -->
        <div class="card">

            <div class="card-header">

                <div>
                    <h2>
                        Risk Assessment
                    </h2>

                    <p class="card-subtitle">
                        Security risk identified from the analyzed configuration.
                    </p>
                </div>

                <span class="badge badge-warning">
                    <%= result.riskLevel %>
                </span>

            </div>

        </div>


        <!-- SUGGESTED ACTION -->
        <div class="card">

            <div class="card-header">

                <div>
                    <h2>
                        Suggested Action
                    </h2>

                    <p class="card-subtitle">
                        Recommended action based on the AI analysis.
                    </p>
                </div>

            </div>


            <div class="finding-card">

                <p>
                    <%= result.suggestedAction %>
                </p>

            </div>

        </div>

    </section>

    <% } %>


    <!-- QUICK ACTIONS -->
    <section class="content-section">

        <div class="section-heading">

            <div>
                <h2>
                    Quick Actions
                </h2>

                <p>
                    Continue working with NETSENTRY security analysis tools.
                </p>
            </div>

        </div>


        <div class="quick-actions-grid">

            <a
                href="/dashboard"
                class="quick-action-card"
            >
                <span class="quick-action-icon">
                    ⌂
                </span>

                <span class="quick-action-content">
                    <strong>Dashboard</strong>
                    <small>Back to dashboard</small>
                </span>

                <span class="quick-action-arrow">
                    →
                </span>
            </a>


            <a
                href="/configurations"
                class="quick-action-card"
            >
                <span class="quick-action-icon">
                    📁
                </span>

                <span class="quick-action-content">
                    <strong>Configurations</strong>
                    <small>View configurations</small>
                </span>

                <span class="quick-action-arrow">
                    →
                </span>
            </a>


            <a
                href="/configurations/upload"
                class="quick-action-card"
            >
                <span class="quick-action-icon">
                    📤
                </span>

                <span class="quick-action-content">
                    <strong>Upload Configuration</strong>
                    <small>Run a new security audit</small>
                </span>

                <span class="quick-action-arrow">
                    →
                </span>
            </a>


            <a
                href="/security-posture"
                class="quick-action-card"
            >
                <span class="quick-action-icon">
                    🛡️
                </span>

                <span class="quick-action-content">
                    <strong>Security Posture</strong>
                    <small>View security posture</small>
                </span>

                <span class="quick-action-arrow">
                    →
                </span>
            </a>


            <a
                href="/risk"
                class="quick-action-card"
            >
                <span class="quick-action-icon">
                    ⚠️
                </span>

                <span class="quick-action-content">
                    <strong>Risk Prioritization</strong>
                    <small>Analyze security risks</small>
                </span>

                <span class="quick-action-arrow">
                    →
                </span>
            </a>


            <a
                href="/exposure"
                class="quick-action-card"
            >
                <span class="quick-action-icon">
                    🌐
                </span>

                <span class="quick-action-content">
                    <strong>Exposure Analysis</strong>
                    <small>Analyze attack surface</small>
                </span>

                <span class="quick-action-arrow">
                    →
                </span>
            </a>


            <a
                href="/reports"
                class="quick-action-card"
            >
                <span class="quick-action-icon">
                    📄
                </span>

                <span class="quick-action-content">
                    <strong>Reports</strong>
                    <small>View security reports</small>
                </span>

                <span class="quick-action-arrow">
                    →
                </span>
            </a>

        </div>

    </section>

</main>

<%- include("../partials/footer") %>