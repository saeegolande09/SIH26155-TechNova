<%- include("../partials/head", { title: "Audit Results - NETSENTRY" }) %>

<%- include("../partials/navbar") %>

<%- include("../partials/sidebar") %>

<main>

    <h1>NETSENTRY Audit Results</h1>

    <%- include("../partials/flash") %>

    <hr>

    <h2>
        <%= device.deviceName %>
    </h2>

    <p>
        <strong>Vendor:</strong>
        <%= device.vendor %>
    </p>

    <p>
        <strong>Audit Status:</strong>
        <%= audit.status %>
    </p>

    <hr>

    <h2>Security Compliance Score</h2>

    <h1>
        <%= audit.complianceScore %>%
    </h1>

    <hr>

    <h2>Audit Summary</h2>

    <p>
        <strong>Total Checks:</strong>
        <%= audit.totalChecks %>
    </p>

    <p>
        <strong>Passed Checks:</strong>
        <%= audit.passedChecks %>
    </p>

    <p>
        <strong>Failed Checks:</strong>
        <%= audit.failedChecks %>
    </p>

    <p>
        <strong>Critical Findings:</strong>
        <%= audit.criticalFindings %>
    </p>

    <p>
        <strong>High Findings:</strong>
        <%= audit.highFindings %>
    </p>

    <p>
        <strong>Medium Findings:</strong>
        <%= audit.mediumFindings %>
    </p>

    <p>
        <strong>Low Findings:</strong>
        <%= audit.lowFindings %>
    </p>

    <hr>

    <h2>Security Rule Status</h2>

    <%
        const rules =
            typeof ruleStatus !== "undefined"
                ? ruleStatus
                : {};
    %>

    <p>
        <strong>Remote Access:</strong>

        <% if (rules["Remote Access"] === "PASS") { %>
            PASS
        <% } else if (rules["Remote Access"] === "FAIL") { %>
            FAIL
        <% } else { %>
            Not Available
        <% } %>
    </p>

    <p>
        <strong>Encryption:</strong>

        <% if (rules["Encryption"] === "PASS") { %>
            PASS
        <% } else if (rules["Encryption"] === "FAIL") { %>
            FAIL
        <% } else { %>
            Not Available
        <% } %>
    </p>

    <p>
        <strong>Access Control:</strong>

        <% if (rules["Access Control"] === "PASS") { %>
            PASS
        <% } else if (rules["Access Control"] === "FAIL") { %>
            FAIL
        <% } else { %>
            Not Available
        <% } %>
    </p>

    <p>
        <strong>Authentication:</strong>

        <% if (rules["Authentication"] === "PASS") { %>
            PASS
        <% } else if (rules["Authentication"] === "FAIL") { %>
            FAIL
        <% } else { %>
            Not Available
        <% } %>
    </p>

    <hr>

    <h2>Security Findings</h2>

    <% if (findings && findings.length > 0) { %>

        <% findings.forEach(function(finding) { %>

            <div>

                <h3>
                    <a href="/findings/<%= finding._id %>">
                        <%= finding.title %>
                    </a>
                </h3>

                <p>
                    <strong>Severity:</strong>
                    <%= finding.severity %>
                </p>

                <p>
                    <strong>Category:</strong>
                    <%= finding.category %>
                </p>

                <p>
                    <strong>Description:</strong>
                    <%= finding.description %>
                </p>

                <% if (finding.detectedConfig) { %>

                    <p>
                        <strong>Detected Configuration:</strong>
                    </p>

                    <pre><%= finding.detectedConfig %></pre>

                <% } %>

                <% if (finding.recommendedFix) { %>

                    <p>
                        <strong>Recommended Fix:</strong>
                        <%= finding.recommendedFix %>
                    </p>

                <% } %>

                <p>
                    <a href="/remediations/<%= finding._id %>">
                        Open Remediation
                    </a>
                </p>

            </div>

            <hr>

        <% }); %>

    <% } else { %>

        <h3>No Security Findings</h3>

        <p>
            This configuration passed all security checks.
        </p>

    <% } %>

    <hr>

    <h2>Quick Actions</h2>

    <p>
        <a href="/dashboard">
            Back to Dashboard
        </a>
    </p>

    <p>
        <a href="/audits">
            Audit History
        </a>
    </p>

    <p>
        <a href="/configurations">
            Configurations
        </a>
    </p>

    <p>
        <a href="/configurations/upload">
            Upload Another Configuration
        </a>
    </p>

    <p>
        <a href="/security-posture">
            Security Posture
        </a>
    </p>

    <p>
        <a href="/risk">
            Risk Prioritization
        </a>
    </p>

    <p>
        <a href="/reports">
            Reports
        </a>
    </p>

</main>

<%- include("../partials/footer") %>