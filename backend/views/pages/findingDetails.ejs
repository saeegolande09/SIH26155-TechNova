<%- include("../partials/head", { title: "Finding Details - NETSENTRY" }) %>

<%- include("../partials/navbar") %>

<%- include("../partials/sidebar") %>


<main class="main-content finding-details-page">

    <!-- =========================================
         PAGE HEADER
         ========================================= -->

    <div class="page-header">

        <div>

            <h1 class="page-title">
                Finding Details
            </h1>

            <p class="page-subtitle">
                Detailed analysis of a detected security finding.
            </p>

        </div>


        <a
            href="/findings"
            class="btn btn-secondary"
        >
            ← Back to Findings
        </a>

    </div>


    <%- include("../partials/flash") %>


    <% if (!finding) { %>


        <!-- =========================================
             NOT FOUND
             ========================================= -->

        <section class="finding-empty card">

            <div class="empty-state">

                <div class="empty-state-icon">
                    🔍
                </div>

                <h2>
                    Finding Not Found
                </h2>

                <p>
                    The requested security finding could not be found.
                </p>

                <a
                    href="/findings"
                    class="btn btn-primary"
                >
                    Back to Findings
                </a>

            </div>

        </section>


    <% } else { %>


        <!-- =========================================
             FINDING OVERVIEW
             ========================================= -->

        <section class="finding-overview-card card">

            <div class="finding-overview-header">

                <div class="finding-overview-main">

                    <div class="finding-title-row">

                        <h2>
                            <%= finding.title %>
                        </h2>

                        <span
                            class="finding-severity finding-severity-<%= String(finding.severity || 'low').toLowerCase() %>"
                        >
                            <%= finding.severity %>
                        </span>

                    </div>


                    <div class="finding-meta">

                        <span class="finding-meta-badge">
                            <%= finding.category || "Other" %>
                        </span>

                        <span class="finding-meta-badge">
                            <%= finding.status %>
                        </span>

                    </div>

                </div>

            </div>

        </section>



        <!-- =========================================
             DESCRIPTION
             ========================================= -->

        <section class="finding-section card">

            <div class="finding-section-header">

                <h2>
                    Description
                </h2>

                <p>
                    Explanation of the detected security issue.
                </p>

            </div>


            <div class="finding-section-body">

                <p class="finding-description-text">
                    <%= finding.description %>
                </p>

            </div>

        </section>



        <!-- =========================================
             DETECTED CONFIGURATION
             ========================================= -->

        <% if (finding.detectedConfig) { %>

            <section class="finding-section card">

                <div class="finding-section-header">

                    <h2>
                        Detected Configuration
                    </h2>

                    <p>
                        Configuration responsible for triggering this finding.
                    </p>

                </div>


                <div class="finding-section-body">

                    <pre class="finding-code-block"><%= finding.detectedConfig %></pre>

                </div>

            </section>

        <% } %>



        <!-- =========================================
             AI EXPLANATION
             ========================================= -->

        <% if (finding.aiExplanation) { %>

            <section class="finding-section card ai-finding-section">

                <div class="finding-section-header">

                    <div>

                        <h2>
                            AI Explanation
                        </h2>

                        <p>
                            AI-generated explanation of the security finding.
                        </p>

                    </div>

                    <span class="ai-badge">
                        AI
                    </span>

                </div>


                <div class="finding-section-body">

                    <p class="finding-description-text">
                        <%= finding.aiExplanation %>
                    </p>

                </div>

            </section>

        <% } %>



        <!-- =========================================
             RECOMMENDED FIX
             ========================================= -->

        <% if (finding.recommendedFix) { %>

            <section class="finding-section card remediation-preview-card">

                <div class="finding-section-header">

                    <div>

                        <h2>
                            Recommended Fix
                        </h2>

                        <p>
                            Suggested remediation for this security finding.
                        </p>

                    </div>

                </div>


                <div class="finding-section-body">

                    <p class="finding-description-text">
                        <%= finding.recommendedFix %>
                    </p>


                    <div class="finding-section-actions">

                        <a
                            href="/remediations/<%= finding._id %>"
                            class="btn btn-primary"
                        >
                            Open Remediation
                        </a>

                    </div>

                </div>

            </section>

        <% } %>



        <!-- =========================================
             DEVICE INFORMATION
             ========================================= -->

        <section class="finding-section card">

            <div class="finding-section-header">

                <h2>
                    Device Information
                </h2>

                <p>
                    Network device associated with this finding.
                </p>

            </div>


            <div class="finding-device-grid">

                <% if (finding.device) { %>


                    <div class="finding-device-item">

                        <span>
                            Device
                        </span>

                        <strong>
                            <%= finding.device.deviceName %>
                        </strong>

                    </div>


                    <div class="finding-device-item">

                        <span>
                            Vendor
                        </span>

                        <strong>
                            <%= finding.device.vendor %>
                        </strong>

                    </div>


                    <div class="finding-device-item">

                        <span>
                            Device Type
                        </span>

                        <strong>
                            <%= finding.device.deviceType || "Network Device" %>
                        </strong>

                    </div>


                    <div class="finding-device-item">

                        <span>
                            IP Address
                        </span>

                        <strong>
                            <%= finding.device.ipAddress || "N/A" %>
                        </strong>

                    </div>


                <% } else { %>


                    <div class="finding-device-unavailable">

                        <span class="empty-state-icon">
                            🖥️
                        </span>

                        <p>
                            Device information unavailable.
                        </p>

                    </div>


                <% } %>

            </div>

        </section>



        <!-- =========================================
             ACTIONS
             ========================================= -->

        <section class="finding-actions-section">

            <div class="section-heading">

                <div>

                    <h2>
                        Actions
                    </h2>

                    <p>
                        Continue working with this security finding.
                    </p>

                </div>

            </div>


            <div class="finding-actions-grid">


                <!-- REMEDIATION -->

                <a
                    href="/remediations/<%= finding._id %>"
                    class="finding-action-card"
                >

                    <span class="finding-action-icon">
                        🔧
                    </span>

                    <span class="finding-action-content">

                        <strong>
                            Open Remediation
                        </strong>

                        <small>
                            Apply and verify the recommended fix.
                        </small>

                    </span>

                    <span class="finding-action-arrow">
                        →
                    </span>

                </a>



                <!-- RELATED AUDIT -->

                <% if (finding.audit) { %>

                    <a
                        href="/audits/<%= finding.audit._id || finding.audit %>"
                        class="finding-action-card"
                    >

                        <span class="finding-action-icon">
                            🔍
                        </span>

                        <span class="finding-action-content">

                            <strong>
                                Related Audit
                            </strong>

                            <small>
                                View the audit associated with this finding.
                            </small>

                        </span>

                        <span class="finding-action-arrow">
                            →
                        </span>

                    </a>

                <% } %>



                <!-- ALL FINDINGS -->

                <a
                    href="/findings"
                    class="finding-action-card"
                >

                    <span class="finding-action-icon">
                        🚨
                    </span>

                    <span class="finding-action-content">

                        <strong>
                            All Findings
                        </strong>

                        <small>
                            View all security findings.
                        </small>

                    </span>

                    <span class="finding-action-arrow">
                        →
                    </span>

                </a>



                <!-- DASHBOARD -->

                <a
                    href="/dashboard"
                    class="finding-action-card"
                >

                    <span class="finding-action-icon">
                        🏠
                    </span>

                    <span class="finding-action-content">

                        <strong>
                            Dashboard
                        </strong>

                        <small>
                            Return to the NETSENTRY dashboard.
                        </small>

                    </span>

                    <span class="finding-action-arrow">
                        →
                    </span>

                </a>


            </div>

        </section>


    <% } %>


</main>


<%- include("../partials/footer") %>