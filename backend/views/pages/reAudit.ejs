<%- include("../partials/head", { title: "Re-Audit - NETSENTRY" }) %>

<%- include("../partials/navbar") %>

<%- include("../partials/sidebar") %>

<main>

    <h1>
        NETSENTRY - Re-Audit
    </h1>

    <%- include("../partials/flash") %>

    <hr>

    <h2>
        Device Information
    </h2>

    <p>
        <strong>Device:</strong>
        <%= device.deviceName %>
    </p>

    <p>
        <strong>Vendor:</strong>
        <%= device.vendor %>
    </p>

    <p>
        <strong>Configuration:</strong>
        <%= configuration.fileName %>
    </p>

    <hr>

    <% if (!completed) { %>

        <h2>
            Run Security Re-Audit
        </h2>

        <p>
            NETSENTRY will analyze the configuration
            again using the security engine.
        </p>

        <form
            action="/audits/<%= audit._id %>/reaudit"
            method="POST"
        >

            <button type="submit">
                Start Re-Audit
            </button>

        </form>

    <% } %>


    <% if (completed) { %>

        <h2>
            Re-Audit Completed
        </h2>

        <p>
            <strong>Audit Status:</strong>
            <%= audit.status %>
        </p>

        <hr>

        <h2>
            New Security Score
        </h2>

        <h1>
            <%= audit.complianceScore %>%
        </h1>

        <hr>

        <h2>
            Audit Summary
        </h2>

        <p>
            <strong>Total Checks:</strong>
            <%= audit.totalChecks %>
        </p>

        <p>
            <strong>Passed Checks:</strong>
            <%= audit.passedChecks %>
        </p>

        <p>
            <strong>Failed Checks:</strong>
            <%= audit.failedChecks %>
        </p>

        <p>
            <strong>Critical Findings:</strong>
            <%= audit.criticalFindings %>
        </p>

        <p>
            <strong>High Findings:</strong>
            <%= audit.highFindings %>
        </p>

        <p>
            <strong>Medium Findings:</strong>
            <%= audit.mediumFindings %>
        </p>

        <p>
            <strong>Low Findings:</strong>
            <%= audit.lowFindings %>
        </p>

        <hr>

        <h2>
            Security Rule Status
        </h2>

        <%
            const rules =
                typeof ruleStatus !== "undefined"
                    ? ruleStatus
                    : {};
        %>

        <p>
            <strong>Remote Access:</strong>

            <% if (rules["Remote Access"] === "PASS") { %>
                PASS
            <% } else if (rules["Remote Access"] === "FAIL") { %>
                FAIL
            <% } else { %>
                Not Available
            <% } %>
        </p>

        <p>
            <strong>Encryption:</strong>

            <% if (rules["Encryption"] === "PASS") { %>
                PASS
            <% } else if (rules["Encryption"] === "FAIL") { %>
                FAIL
            <% } else { %>
                Not Available
            <% } %>
        </p>

        <p>
            <strong>Access Control:</strong>

            <% if (rules["Access Control"] === "PASS") { %>
                PASS
            <% } else if (rules["Access Control"] === "FAIL") { %>
                FAIL
            <% } else { %>
                Not Available
            <% } %>
        </p>

        <p>
            <strong>Authentication:</strong>

            <% if (rules["Authentication"] === "PASS") { %>
                PASS
            <% } else if (rules["Authentication"] === "FAIL") { %>
                FAIL
            <% } else { %>
                Not Available
            <% } %>
        </p>

        <hr>

        <h2>
            Current Findings
        </h2>

        <% if (findings && findings.length > 0) { %>

            <% findings.forEach(function(finding) { %>

                <div>

                    <h3>
                        <a href="/findings/<%= finding._id %>">
                            <%= finding.title %>
                        </a>
                    </h3>

                    <p>
                        <strong>Severity:</strong>
                        <%= finding.severity %>
                    </p>

                    <p>
                        <strong>Category:</strong>
                        <%= finding.category %>
                    </p>

                    <p>
                        <strong>Status:</strong>
                        <%= finding.status %>
                    </p>

                    <% if (finding.detectedConfig) { %>

                        <p>
                            <strong>
                                Detected Configuration:
                            </strong>
                        </p>

                        <pre><%= finding.detectedConfig %></pre>

                    <% } %>

                    <% if (finding.recommendedFix) { %>

                        <p>
                            <strong>
                                Recommended Fix:
                            </strong>

                            <%= finding.recommendedFix %>
                        </p>

                    <% } %>

                    <p>
                        <a href="/remediations/<%= finding._id %>">
                            Open Remediation
                        </a>
                    </p>

                </div>

                <hr>

            <% }); %>

        <% } else { %>

            <h3>
                ✓ No Security Findings
            </h3>

            <p>
                Configuration passed all security checks.
            </p>

        <% } %>

        <h2>
            Re-Audit Result
        </h2>

        <% if (audit.failedChecks === 0) { %>

            <p>
                All security checks passed.
            </p>

        <% } else { %>

            <p>
                Security issues are still present
                in the configuration.
            </p>

        <% } %>

    <% } %>


    <hr>

    <h2>
        Quick Actions
    </h2>

    <p>
        <a href="/dashboard">
            Back to Dashboard
        </a>
    </p>

    <p>
        <a href="/audits">
            Audit History
        </a>
    </p>

    <p>
        <a href="/configurations">
            View Configurations
        </a>
    </p>

    <p>
        <a href="/configurations/upload">
            Upload New Configuration
        </a>
    </p>

    <p>
        <a href="/security-posture">
            Security Posture
        </a>
    </p>

    <p>
        <a href="/reports">
            Reports
        </a>
    </p>

</main>

<%- include("../partials/footer") %>