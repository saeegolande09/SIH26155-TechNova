<%- include("../partials/head", { title: "Configuration Drift - NETSENTRY" }) %>

<%- include("../partials/navbar") %>

<%- include("../partials/sidebar") %>

<main>

    <h1>NETSENTRY - Configuration Drift</h1>

    <%- include("../partials/flash") %>

    <hr>

    <h2>Select Configurations</h2>

    <form
        action="/drift/compare"
        method="POST"
    >

        <p>
            <strong>Old Configuration:</strong>
        </p>

        <select name="oldConfiguration" required>

            <option value="">
                Select Old Configuration
            </option>

            <% configurations.forEach(function(config) { %>

                <option value="<%= config._id %>">

                    <%= config.fileName %> -

                    <%= config.device
                        ? config.device.deviceName
                        : "Unknown Device" %>

                </option>

            <% }); %>

        </select>

        <br><br>

        <p>
            <strong>New Configuration:</strong>
        </p>

        <select name="newConfiguration" required>

            <option value="">
                Select New Configuration
            </option>

            <% configurations.forEach(function(config) { %>

                <option value="<%= config._id %>">

                    <%= config.fileName %> -

                    <%= config.device
                        ? config.device.deviceName
                        : "Unknown Device" %>

                </option>

            <% }); %>

        </select>

        <br><br>

        <button type="submit">
            Compare Configurations
        </button>

    </form>


    <% if (result) { %>

        <hr>

        <h2>Drift Analysis Result</h2>

        <p>
            <strong>Drift Detected:</strong>
            <%= result.driftDetected ? "Yes" : "No" %>
        </p>

        <p>
            <strong>Changed Lines:</strong>
            <%= result.changedLines %>
        </p>

        <p>
            <strong>Risk Level:</strong>
            <%= result.riskLevel %>
        </p>

        <p>
            <strong>Security Impact:</strong>
            <%= result.securityImpact %>
        </p>

        <hr>

        <h2>Added Configuration</h2>

        <% if (result.added && result.added.length > 0) { %>

            <% result.added.forEach(function(line) { %>

                <p>
                    <code>
                        + <%= line %>
                    </code>
                </p>

            <% }); %>

        <% } else { %>

            <p>
                No configuration lines added.
            </p>

        <% } %>

        <hr>

        <h2>Removed Configuration</h2>

        <% if (result.removed && result.removed.length > 0) { %>

            <% result.removed.forEach(function(line) { %>

                <p>
                    <code>
                        - <%= line %>
                    </code>
                </p>

            <% }); %>

        <% } else { %>

            <p>
                No configuration lines removed.
            </p>

        <% } %>

    <% } %>


    <hr>

    <h2>Quick Actions</h2>

    <p>
        <a href="/dashboard">
            Back to Dashboard
        </a>
    </p>

    <p>
        <a href="/configurations">
            View Configurations
        </a>
    </p>

    <p>
        <a href="/configurations/upload">
            Upload New Configuration
        </a>
    </p>

    <p>
        <a href="/comparison">
            Device Comparison
        </a>
    </p>

    <p>
        <a href="/security-posture">
            Security Posture
        </a>
    </p>

    <p>
        <a href="/risk">
            Risk Prioritization
        </a>
    </p>

</main>

<%- include("../partials/footer") %>