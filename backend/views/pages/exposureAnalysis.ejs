<%- include("../partials/head", { title: "NETSENTRY - Exposure Analysis" }) %>

<%- include("../partials/navbar") %>
<%- include("../partials/sidebar") %>

<main class="main-content">

    <!-- Page Header -->
    <div class="page-header">
        <div>
            <h1>Exposure Analysis</h1>
            <p class="page-description">
                Analyze network exposure, reachable services, and access control rules.
            </p>
        </div>

        <div class="page-actions">
            <a href="/security-posture" class="btn btn-secondary">
                Security Posture
            </a>

            <a href="/risk" class="btn btn-primary">
                Risk Prioritization
            </a>
        </div>
    </div>


    <!-- Configuration Selection -->
    <section class="card">

        <div class="card-header">
            <div>
                <h2>Analyze Configuration</h2>
                <p class="card-subtitle">
                    Select a configuration to analyze its network exposure.
                </p>
            </div>
        </div>


        <form action="/exposure/analyze" method="POST">

            <div class="form-group">

                <label class="form-label" for="configuration">
                    Configuration
                </label>

                <select
                    class="form-control"
                    id="configuration"
                    name="configurationId"
                    required
                >

                    <option value="">
                        Select Configuration
                    </option>

                    <% configurations.forEach(function(config) { %>

                        <option
                            value="<%= config._id %>"
                            <%= selectedConfiguration &&
                                selectedConfiguration._id.toString() === config._id.toString()
                                ? "selected"
                                : "" %>
                        >
                            <%= config.fileName %>
                            -
                            <%= config.device?.deviceName || "Unknown Device" %>
                        </option>

                    <% }); %>

                </select>

            </div>


            <button
                type="submit"
                class="btn btn-primary"
            >
                Analyze Exposure
            </button>

        </form>

    </section>


    <% if (result) { %>

    <!-- Exposure Overview -->
    <section class="stats-grid">

        <div class="stat-card">

            <div class="stat-icon">
                🌐
            </div>

            <div class="stat-content">

                <span class="stat-label">
                    Attack Surface Score
                </span>

                <strong class="stat-value">
                    <%= result.attackSurfaceScore %>
                </strong>

            </div>

        </div>


        <div class="stat-card">

            <div class="stat-icon">
                ⚠️
            </div>

            <div class="stat-content">

                <span class="stat-label">
                    Risk Level
                </span>

                <strong class="stat-value">
                    <%= result.riskLevel %>
                </strong>

            </div>

        </div>


        <div class="stat-card">

            <div class="stat-icon">
                🔓
            </div>

            <div class="stat-content">

                <span class="stat-label">
                    Permit Rules
                </span>

                <strong class="stat-value">
                    <%= result.totalPermitRules %>
                </strong>

            </div>

        </div>


        <div class="stat-card">

            <div class="stat-icon">
                🔒
            </div>

            <div class="stat-content">

                <span class="stat-label">
                    Deny Rules
                </span>

                <strong class="stat-value">
                    <%= result.totalDenyRules %>
                </strong>

            </div>

        </div>

    </section>


    <!-- Exposure Summary -->
    <section class="card">

        <div class="card-header">

            <div>
                <h2>Exposure Summary</h2>
                <p class="card-subtitle">
                    Security exposure detected in the selected configuration.
                </p>
            </div>

            <span class="badge badge-warning">
                <%= result.riskLevel %>
            </span>

        </div>


        <div class="stats-grid">

            <div class="stat-card">

                <div class="stat-content">

                    <span class="stat-label">
                        Reachable Rules
                    </span>

                    <strong class="stat-value">
                        <%= result.totalReachableRules %>
                    </strong>

                </div>

            </div>


            <div class="stat-card">

                <div class="stat-content">

                    <span class="stat-label">
                        Exposed Services
                    </span>

                    <strong class="stat-value">
                        <%= result.exposedServices.length %>
                    </strong>

                </div>

            </div>

        </div>

    </section>


    <!-- Exposed Services -->
    <section class="card">

        <div class="card-header">

            <div>
                <h2>Exposed Services</h2>
                <p class="card-subtitle">
                    Services identified as exposed by the analysis.
                </p>
            </div>

            <span class="badge badge-danger">
                <%= result.exposedServices.length %>
            </span>

        </div>


        <% if (result.exposedServices.length > 0) { %>

            <div class="findings-list">

                <% result.exposedServices.forEach(function(service) { %>

                    <div class="finding-card">

                        <div class="finding-header">

                            <div>
                                <h3>
                                    <%= service.service || service.name || service %>
                                </h3>

                                <% if (service.description) { %>

                                    <p class="text-muted">
                                        <%= service.description %>
                                    </p>

                                <% } %>
                            </div>

                            <span class="badge badge-danger">
                                Exposed
                            </span>

                        </div>


                        <% if (service.port || service.protocol) { %>

                            <div class="finding-meta">

                                <% if (service.protocol) { %>

                                    <span class="badge badge-neutral">
                                        Protocol:
                                        <%= service.protocol %>
                                    </span>

                                <% } %>


                                <% if (service.port) { %>

                                    <span class="badge badge-neutral">
                                        Port:
                                        <%= service.port %>
                                    </span>

                                <% } %>

                            </div>

                        <% } %>

                    </div>

                <% }); %>

            </div>

        <% } else { %>

            <div class="empty-state">

                <div class="empty-state-icon">
                    ✓
                </div>

                <h3>No Exposed Services</h3>

                <p>
                    No exposed services were detected in this configuration.
                </p>

            </div>

        <% } %>

    </section>


    <!-- Reachable Rules -->
    <section class="card">

        <div class="card-header">

            <div>
                <h2>Reachable Access Rules</h2>
                <p class="card-subtitle">
                    Rules that allow traffic between network sources and destinations.
                </p>
            </div>

            <span class="badge badge-warning">
                <%= result.totalReachableRules %>
            </span>

        </div>


        <% if (result.reachableRules.length > 0) { %>

            <div class="table-container">

                <table class="data-table">

                    <thead>

                        <tr>
                            <th>Rule</th>
                            <th>Source</th>
                            <th>Destination</th>
                            <th>Protocol</th>
                            <th>Port</th>
                        </tr>

                    </thead>


                    <tbody>

                        <% result.reachableRules.forEach(function(item) { %>

                            <tr>

                                <td>
                                    <strong>
                                        <%= item.rule %>
                                    </strong>
                                </td>

                                <td>
                                    <%= item.source %>
                                </td>

                                <td>
                                    <%= item.destination %>
                                </td>

                                <td>
                                    <span class="badge badge-neutral">
                                        <%= item.protocol %>
                                    </span>
                                </td>

                                <td>
                                    <%= item.port %>
                                </td>

                            </tr>

                        <% }); %>

                    </tbody>

                </table>

            </div>

        <% } else { %>

            <div class="empty-state">

                <h3>No Reachable Rules</h3>

                <p>
                    No reachable access rules were detected.
                </p>

            </div>

        <% } %>

    </section>


    <!-- Rule Analysis -->
    <section class="card">

        <div class="card-header">

            <div>
                <h2>Access Control Analysis</h2>
                <p class="card-subtitle">
                    Overview of permit and deny rules detected in the configuration.
                </p>
            </div>

        </div>


        <div class="stats-grid">

            <div class="stat-card">

                <div class="stat-icon">
                    🔓
                </div>

                <div class="stat-content">

                    <span class="stat-label">
                        Permit Rules
                    </span>

                    <strong class="stat-value">
                        <%= result.totalPermitRules %>
                    </strong>

                </div>

            </div>


            <div class="stat-card">

                <div class="stat-icon">
                    🔒
                </div>

                <div class="stat-content">

                    <span class="stat-label">
                        Deny Rules
                    </span>

                    <strong class="stat-value">
                        <%= result.totalDenyRules %>
                    </strong>

                </div>

            </div>


            <div class="stat-card">

                <div class="stat-icon">
                    🔗
                </div>

                <div class="stat-content">

                    <span class="stat-label">
                        Reachable Rules
                    </span>

                    <strong class="stat-value">
                        <%= result.totalReachableRules %>
                    </strong>

                </div>

            </div>

        </div>

    </section>

    <% } else { %>

    <!-- Empty Analysis State -->
    <section class="card">

        <div class="empty-state">

            <div class="empty-state-icon">
                🔍
            </div>

            <h2>Ready for Exposure Analysis</h2>

            <p>
                Select a network configuration above to analyze
                attack surface, exposed services, ACL rules, and network reachability.
            </p>

        </div>

    </section>

    <% } %>


    <!-- Quick Actions -->
    <section class="card">

        <div class="card-header">

            <div>
                <h2>Quick Actions</h2>
                <p class="card-subtitle">
                    Continue your security analysis workflow.
                </p>
            </div>

        </div>


        <div class="quick-actions">

            <a href="/dashboard" class="btn btn-secondary">
                Dashboard
            </a>

            <a href="/configurations" class="btn btn-secondary">
                Configurations
            </a>

            <a href="/security-posture" class="btn btn-secondary">
                Security Posture
            </a>

            <a href="/risk" class="btn btn-secondary">
                Risk Prioritization
            </a>

            <a href="/drift" class="btn btn-secondary">
                Configuration Drift
            </a>

            <a href="/comparison" class="btn btn-secondary">
                Device Comparison
            </a>

            <a href="/reports" class="btn btn-primary">
                Reports
            </a>

        </div>

    </section>

</main>

<%- include("../partials/footer") %>