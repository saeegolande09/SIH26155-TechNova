<%- include("../partials/head", { title: "Remediation - NETSENTRY" }) %>

<%- include("../partials/navbar") %>

<%- include("../partials/sidebar") %>


<main class="main-content remediation-page">

    <!-- =========================================
         PAGE HEADER
         ========================================= -->

    <div class="page-header">

        <div>

            <h1 class="page-title">
                Remediation
            </h1>

            <p class="page-subtitle">
                Apply, verify, and track the remediation of a security finding.
            </p>

        </div>

    </div>


    <%- include("../partials/flash") %>


    <!-- =========================================
         FINDING SUMMARY
         ========================================= -->

    <section class="remediation-card card">

        <div class="remediation-card-header">

            <div>

                <h2>
                    <%= finding.title %>
                </h2>

                <p>
                    Security finding requiring remediation.
                </p>

            </div>


            <span
                class="remediation-status-badge remediation-status-<%= String(remediation.status || 'Pending').toLowerCase() %>"
            >
                <%= remediation.status %>
            </span>

        </div>


        <div class="remediation-info-grid">

            <div class="remediation-info-item">

                <span>
                    Severity
                </span>

                <strong>
                    <%= finding.severity %>
                </strong>

            </div>


            <div class="remediation-info-item">

                <span>
                    Category
                </span>

                <strong>
                    <%= finding.category %>
                </strong>

            </div>


            <div class="remediation-info-item">

                <span>
                    Finding Status
                </span>

                <strong>
                    <%= finding.status %>
                </strong>

            </div>


            <div class="remediation-info-item">

                <span>
                    Fix Type
                </span>

                <strong>
                    <%= remediation.fixType %>
                </strong>

            </div>

        </div>

    </section>



    <!-- =========================================
         SECURITY ISSUE
         ========================================= -->

    <section class="remediation-card card">

        <div class="remediation-section-header">

            <h2>
                Security Issue
            </h2>

            <p>
                Description of the security issue detected during the audit.
            </p>

        </div>


        <div class="remediation-section-body">

            <p class="remediation-description">
                <%= finding.description %>
            </p>

        </div>

    </section>



    <!-- =========================================
         DETECTED CONFIGURATION
         ========================================= -->

    <% if (finding.detectedConfig) { %>

        <section class="remediation-card card">

            <div class="remediation-section-header">

                <h2>
                    Detected Configuration
                </h2>

                <p>
                    Configuration responsible for triggering this finding.
                </p>

            </div>


            <div class="remediation-section-body">

                <pre class="remediation-code"><%= finding.detectedConfig %></pre>

            </div>

        </section>

    <% } %>



    <!-- =========================================
         RECOMMENDED FIX
         ========================================= -->

    <section class="remediation-card card">

        <div class="remediation-section-header">

            <h2>
                Recommended Fix
            </h2>

            <p>
                Recommended remediation for this security issue.
            </p>

        </div>


        <div class="remediation-section-body">

            <% if (remediation.recommendedFix) { %>

                <p class="remediation-description">
                    <%= remediation.recommendedFix %>
                </p>

            <% } else { %>

                <p class="remediation-muted">
                    No recommended fix is available.
                </p>

            <% } %>

        </div>

    </section>



    <!-- =========================================
         REMEDIATION STATUS
         ========================================= -->

    <section class="remediation-card card">

        <div class="remediation-section-header">

            <div>

                <h2>
                    Remediation Status
                </h2>

                <p>
                    Current remediation workflow state.
                </p>

            </div>


            <span
                class="remediation-status-badge remediation-status-<%= String(remediation.status || 'Pending').toLowerCase() %>"
            >
                <%= remediation.status %>
            </span>

        </div>


        <div class="remediation-info-grid">

            <div class="remediation-info-item">

                <span>
                    Current Status
                </span>

                <strong>
                    <%= remediation.status %>
                </strong>

            </div>


            <div class="remediation-info-item">

                <span>
                    Fix Type
                </span>

                <strong>
                    <%= remediation.fixType %>
                </strong>

            </div>

        </div>

    </section>



    <!-- =========================================
         SUGGESTED COMMANDS
         ========================================= -->

    <% if (remediation.commands && remediation.commands.length > 0) { %>

        <section class="remediation-card card">

            <div class="remediation-section-header">

                <h2>
                    Suggested Commands
                </h2>

                <p>
                    Commands that can be used to apply the recommended configuration change.
                </p>

            </div>


            <div class="remediation-section-body">

                <pre class="remediation-code"><% remediation.commands.forEach(function(command) { %><%= command %>
<% }) %></pre>

            </div>

        </section>

    <% } %>



    <!-- =========================================
         PENDING
         ========================================= -->

    <% if (remediation.status === "Pending") { %>

        <section class="remediation-workflow-card card">

            <div class="workflow-step">

                <div class="workflow-step-number">
                    1
                </div>


                <div class="workflow-step-content">

                    <h2>
                        Apply Fix
                    </h2>

                    <p>
                        Apply the recommended security fix to the network configuration.
                    </p>


                    <form
                        action="/remediations/<%= finding._id %>/apply"
                        method="POST"
                        class="remediation-form"
                    >

                        <button
                            type="submit"
                            class="btn btn-primary"
                        >
                            Apply Fix
                        </button>

                    </form>

                </div>

            </div>

        </section>

    <% } %>



    <!-- =========================================
         APPLIED
         ========================================= -->

    <% if (remediation.status === "Applied") { %>

        <section class="remediation-workflow-card card">

            <div class="workflow-step">

                <div class="workflow-step-number">
                    2
                </div>


                <div class="workflow-step-content">

                    <h2>
                        Verify Fix
                    </h2>

                    <p>
                        The fix has been applied to the configuration.
                        Verify whether the remediation was successful.
                    </p>


                    <form
                        action="/remediations/<%= finding._id %>/verify"
                        method="POST"
                        class="remediation-form"
                    >

                        <button
                            type="submit"
                            class="btn btn-primary"
                        >
                            Verify Fix
                        </button>

                    </form>

                </div>

            </div>

        </section>

    <% } %>



   <!-- =========================================
     VERIFIED
     ========================================= -->

<% if (remediation.status === "Verified") { %>

    <section class="remediation-workflow-card remediation-success-card card">

        <div class="workflow-step">

            <div class="workflow-step-number workflow-success">
                ✓
            </div>

            <div class="workflow-step-content">

                <h2>
                    Remediation Verified
                </h2>

                <p>
                    This finding has been marked as resolved.
                </p>

                <% if (remediation.verifiedAt) { %>

                    <p class="remediation-muted">

                        <strong>
                            Verified At:
                        </strong>

                        <%= new Date(remediation.verifiedAt).toLocaleString() %>

                    </p>

                <% } %>

                <div class="workflow-action">

                    <a
                        href="/audits/<%= finding.audit %>/reaudit"
                        class="btn btn-primary"
                    >
                        Start Re-Audit
                    </a>

                </div>

            </div>

        </div>

    </section>

<% } %>
    <!-- =========================================
         FAILED
         ========================================= -->

    <% if (remediation.status === "Failed") { %>

        <section class="remediation-workflow-card remediation-failed-card card">

            <div class="workflow-step">

                <div class="workflow-step-number workflow-failed">
                    !
                </div>


                <div class="workflow-step-content">

                    <h2>
                        Remediation Failed
                    </h2>

                    <p>
                        The remediation could not be verified.
                        Review the recommended fix and try again.
                    </p>


                    <form
                        action="/remediations/<%= finding._id %>/apply"
                        method="POST"
                        class="remediation-form"
                    >

                        <button
                            type="submit"
                            class="btn btn-primary"
                        >
                            Try Again
                        </button>

                    </form>

                </div>

            </div>

        </section>

    <% } %>



    <!-- =========================================
         NAVIGATION
         ========================================= -->

    <section class="remediation-navigation">

        <div class="section-heading">

            <div>

                <h2>
                    Navigation
                </h2>

                <p>
                    Continue working with NETSENTRY.
                </p>

            </div>

        </div>


        <div class="remediation-nav-grid">


            <a
                href="/dashboard"
                class="remediation-nav-card"
            >

                <span class="remediation-nav-icon">
                    🏠
                </span>

                <span class="remediation-nav-content">

                    <strong>
                        Dashboard
                    </strong>

                    <small>
                        Return to dashboard
                    </small>

                </span>

                <span>
                    →
                </span>

            </a>



            <a
                href="/configurations"
                class="remediation-nav-card"
            >

                <span class="remediation-nav-icon">
                    📁
                </span>

                <span class="remediation-nav-content">

                    <strong>
                        Configurations
                    </strong>

                    <small>
                        View configurations
                    </small>

                </span>

                <span>
                    →
                </span>

            </a>



            <a
                href="/configurations/upload"
                class="remediation-nav-card"
            >

                <span class="remediation-nav-icon">
                    📤
                </span>

                <span class="remediation-nav-content">

                    <strong>
                        Upload Configuration
                    </strong>

                    <small>
                        Upload a new configuration
                    </small>

                </span>

                <span>
                    →
                </span>

            </a>



            <a
                href="/audits"
                class="remediation-nav-card"
            >

                <span class="remediation-nav-icon">
                    🔍
                </span>

                <span class="remediation-nav-content">

                    <strong>
                        Audits
                    </strong>

                    <small>
                        View audit history
                    </small>

                </span>

                <span>
                    →
                </span>

            </a>


        </div>

    </section>


</main>


<%- include("../partials/footer") %>