<%- include("../partials/head", { title: "Risk Prioritization - NETSENTRY" }) %>

<%- include("../partials/navbar") %>

<%- include("../partials/sidebar") %>

<main>

    <h1>
        NETSENTRY - Risk Prioritization
    </h1>

    <%- include("../partials/flash") %>

    <hr>

    <h2>
        Risk Overview
    </h2>

    <p>
        <strong>Total Open Findings:</strong>
        <%= totalOpenFindings %>
    </p>

    <hr>

    <h2>
        Findings by Severity
    </h2>

    <p>
        <strong>Critical:</strong>
        <%= criticalFindings.length %>
    </p>

    <p>
        <strong>High:</strong>
        <%= highFindings.length %>
    </p>

    <p>
        <strong>Medium:</strong>
        <%= mediumFindings.length %>
    </p>

    <p>
        <strong>Low:</strong>
        <%= lowFindings.length %>
    </p>

    <p>
        <strong>Informational:</strong>
        <%= informationalFindings ? informationalFindings.length : 0 %>
    </p>

    <hr>

    <h2>
        Highest Priority Finding
    </h2>

    <% if (highestPriorityFinding) { %>

        <h3>
            <a href="/findings/<%= highestPriorityFinding._id %>">
                <%= highestPriorityFinding.title %>
            </a>
        </h3>

        <p>
            <strong>Severity:</strong>
            <%= highestPriorityFinding.severity %>
        </p>

        <p>
            <strong>Risk Score:</strong>
            <%= highestPriorityFinding.riskScore || 0 %>/100
        </p>

        <p>
            <strong>Category:</strong>
            <%= highestPriorityFinding.category %>
        </p>

        <p>
            <strong>Device:</strong>
            <%= highestPriorityFinding.device
                ? highestPriorityFinding.device.deviceName
                : "Unknown Device" %>
        </p>

    <% } else { %>

        <p>
            No open security findings.
        </p>

    <% } %>

    <hr>

    <h2>
        Prioritized Security Findings
    </h2>

    <% if (findings && findings.length > 0) { %>

        <% findings.forEach(function(finding, index) { %>

            <div>

                <h3>
                    #<%= index + 1 %> -

                    <a href="/findings/<%= finding._id %>">
                        <%= finding.title %>
                    </a>
                </h3>

                <p>
                    <strong>Priority:</strong>
                    <%= finding.severity %>
                </p>

                <p>
                    <strong>Risk Score:</strong>
                    <%= finding.riskScore || 0 %>/100
                </p>

                <p>
                    <strong>Category:</strong>
                    <%= finding.category %>
                </p>

                <p>
                    <strong>Device:</strong>
                    <%= finding.device
                        ? finding.device.deviceName
                        : "Unknown Device" %>
                </p>

                <p>
                    <strong>Status:</strong>
                    <%= finding.status %>
                </p>

                <p>
                    <strong>Description:</strong>
                    <%= finding.description %>
                </p>

                <p>
                    <strong>Recommended Fix:</strong>
                    <%= finding.recommendedFix
                        || "No recommended fix available." %>
                </p>

                <p>
                    <a href="/findings/<%= finding._id %>">
                        View Finding Details
                    </a>
                </p>

                <p>
                    <a href="/remediations/<%= finding._id %>">
                        Open Remediation
                    </a>
                </p>

            </div>

            <hr>

        <% }); %>

    <% } else { %>

        <h3>
            No Open Security Findings
        </h3>

        <p>
            All current findings are resolved.
        </p>

    <% } %>

    <hr>

    <h2>Quick Actions</h2>

    <p>
        <a href="/dashboard">
            Back to Dashboard
        </a>
    </p>

    <p>
        <a href="/security-posture">
            Security Posture
        </a>
    </p>

    <p>
        <a href="/exposure">
            Exposure Analysis
        </a>
    </p>

    <p>
        <a href="/drift">
            Configuration Drift
        </a>
    </p>

    <p>
        <a href="/comparison">
            Device Comparison
        </a>
    </p>

    <p>
        <a href="/configurations">
            Configurations
        </a>
    </p>

    <p>
        <a href="/reports">
            Reports
        </a>
    </p>

</main>

<%- include("../partials/footer") %>