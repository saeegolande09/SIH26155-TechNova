<%- include("../partials/head", { title: "NETSENTRY - Risk Prioritization" }) %>

<%- include("../partials/navbar") %>
<%- include("../partials/sidebar") %>

<main class="main-content">

    <!-- Page Header -->
    <div class="page-header">
        <div>
            <h1>Risk Prioritization</h1>
            <p class="page-description">
                Identify and prioritize security findings based on severity and risk score.
            </p>
        </div>

        <div class="page-actions">
            <a href="/security-posture" class="btn btn-secondary">
                Security Posture
            </a>

            <a href="/reports" class="btn btn-primary">
                Generate Report
            </a>
        </div>
    </div>


    <!-- Overview -->
    <section class="stats-grid">

        <div class="stat-card">
            <div class="stat-icon">
                ⚠️
            </div>

            <div class="stat-content">
                <span class="stat-label">Open Findings</span>
                <strong class="stat-value">
                    <%= totalOpenFindings %>
                </strong>
            </div>
        </div>


        <div class="stat-card">
            <div class="stat-icon">
                🔴
            </div>

            <div class="stat-content">
                <span class="stat-label">Critical</span>
                <strong class="stat-value">
                    <%= criticalFindings.length %>
                </strong>
            </div>
        </div>


        <div class="stat-card">
            <div class="stat-icon">
                🟠
            </div>

            <div class="stat-content">
                <span class="stat-label">High</span>
                <strong class="stat-value">
                    <%= highFindings.length %>
                </strong>
            </div>
        </div>


        <div class="stat-card">
            <div class="stat-icon">
                🟡
            </div>

            <div class="stat-content">
                <span class="stat-label">Medium</span>
                <strong class="stat-value">
                    <%= mediumFindings.length %>
                </strong>
            </div>
        </div>

    </section>


    <!-- Highest Priority Finding -->
    <% if (highestPriorityFinding) { %>

    <section class="card">

        <div class="card-header">
            <div>
                <h2>Highest Priority Finding</h2>
                <p class="card-subtitle">
                    Finding requiring immediate attention
                </p>
            </div>

            <span class="badge badge-danger">
                <%= highestPriorityFinding.severity %>
            </span>
        </div>


        <div class="finding-card">

            <div class="finding-header">

                <div>
                    <h3>
                        <%= highestPriorityFinding.title %>
                    </h3>

                    <p class="text-muted">
                        Device:
                        <strong>
                            <%= highestPriorityFinding.device?.deviceName || "Unknown Device" %>
                        </strong>
                    </p>
                </div>

                <div class="risk-score">
                    <span class="risk-score-label">
                        Risk Score
                    </span>

                    <strong>
                        <%= highestPriorityFinding.riskScore %>
                    </strong>
                </div>

            </div>


            <div class="finding-meta">

                <span class="badge badge-danger">
                    <%= highestPriorityFinding.severity %>
                </span>

                <span class="badge badge-neutral">
                    <%= highestPriorityFinding.category %>
                </span>

                <span class="badge badge-neutral">
                    <%= highestPriorityFinding.status %>
                </span>

            </div>


            <div class="finding-description">

                <h4>Description</h4>

                <p>
                    <%= highestPriorityFinding.description %>
                </p>

            </div>


            <div class="finding-actions">

                <a
                    href="/findings/<%= highestPriorityFinding._id %>"
                    class="btn btn-primary"
                >
                    View Finding
                </a>

                <a
                    href="/remediations/<%= highestPriorityFinding._id %>"
                    class="btn btn-secondary"
                >
                    Recommended Fix
                </a>

            </div>

        </div>

    </section>

    <% } %>


    <!-- Critical Findings -->
    <section class="card">

        <div class="card-header">
            <div>
                <h2>Critical Findings</h2>
                <p class="card-subtitle">
                    Highest severity security issues
                </p>
            </div>

            <span class="badge badge-danger">
                <%= criticalFindings.length %>
            </span>
        </div>


        <% if (criticalFindings.length > 0) { %>

            <div class="findings-list">

                <% criticalFindings.forEach(function(finding) { %>

                    <div class="finding-card">

                        <div class="finding-header">

                            <div>
                                <h3>
                                    <%= finding.title %>
                                </h3>

                                <p class="text-muted">
                                    <%= finding.device?.deviceName || "Unknown Device" %>
                                </p>
                            </div>

                            <div class="risk-score">

                                <span class="risk-score-label">
                                    Risk
                                </span>

                                <strong>
                                    <%= finding.riskScore %>
                                </strong>

                            </div>

                        </div>


                        <div class="finding-meta">

                            <span class="badge badge-danger">
                                Critical
                            </span>

                            <span class="badge badge-neutral">
                                <%= finding.category %>
                            </span>

                            <span class="badge badge-neutral">
                                <%= finding.status %>
                            </span>

                        </div>


                        <div class="finding-actions">

                            <a
                                href="/findings/<%= finding._id %>"
                                class="btn btn-sm btn-secondary"
                            >
                                View Details
                            </a>

                            <a
                                href="/remediations/<%= finding._id %>"
                                class="btn btn-sm btn-primary"
                            >
                                Fix Issue
                            </a>

                        </div>

                    </div>

                <% }); %>

            </div>

        <% } else { %>

            <div class="empty-state">

                <div class="empty-state-icon">
                    ✓
                </div>

                <h3>No Critical Findings</h3>

                <p>
                    No critical security findings are currently open.
                </p>

            </div>

        <% } %>

    </section>


    <!-- High Findings -->
    <section class="card">

        <div class="card-header">
            <div>
                <h2>High Risk Findings</h2>
                <p class="card-subtitle">
                    High severity issues requiring attention
                </p>
            </div>

            <span class="badge badge-warning">
                <%= highFindings.length %>
            </span>
        </div>


        <% if (highFindings.length > 0) { %>

            <div class="findings-list">

                <% highFindings.forEach(function(finding) { %>

                    <div class="finding-card">

                        <div class="finding-header">

                            <div>
                                <h3>
                                    <%= finding.title %>
                                </h3>

                                <p class="text-muted">
                                    <%= finding.device?.deviceName || "Unknown Device" %>
                                </p>
                            </div>

                            <div class="risk-score">

                                <span class="risk-score-label">
                                    Risk
                                </span>

                                <strong>
                                    <%= finding.riskScore %>
                                </strong>

                            </div>

                        </div>


                        <div class="finding-meta">

                            <span class="badge badge-warning">
                                High
                            </span>

                            <span class="badge badge-neutral">
                                <%= finding.category %>
                            </span>

                            <span class="badge badge-neutral">
                                <%= finding.status %>
                            </span>

                        </div>


                        <div class="finding-actions">

                            <a
                                href="/findings/<%= finding._id %>"
                                class="btn btn-sm btn-secondary"
                            >
                                View Details
                            </a>

                            <a
                                href="/remediations/<%= finding._id %>"
                                class="btn btn-sm btn-primary"
                            >
                                Fix Issue
                            </a>

                        </div>

                    </div>

                <% }); %>

            </div>

        <% } else { %>

            <div class="empty-state">

                <h3>No High Risk Findings</h3>

                <p>
                    No high severity security findings are currently open.
                </p>

            </div>

        <% } %>

    </section>


    <!-- Medium Findings -->
    <section class="card">

        <div class="card-header">
            <div>
                <h2>Medium Risk Findings</h2>
                <p class="card-subtitle">
                    Security issues that should be addressed
                </p>
            </div>

            <span class="badge badge-warning">
                <%= mediumFindings.length %>
            </span>
        </div>


        <% if (mediumFindings.length > 0) { %>

            <div class="findings-list">

                <% mediumFindings.forEach(function(finding) { %>

                    <div class="finding-card">

                        <div class="finding-header">

                            <div>
                                <h3>
                                    <%= finding.title %>
                                </h3>

                                <p class="text-muted">
                                    <%= finding.device?.deviceName || "Unknown Device" %>
                                </p>
                            </div>

                            <div class="risk-score">

                                <span class="risk-score-label">
                                    Risk
                                </span>

                                <strong>
                                    <%= finding.riskScore %>
                                </strong>

                            </div>

                        </div>


                        <div class="finding-meta">

                            <span class="badge badge-warning">
                                Medium
                            </span>

                            <span class="badge badge-neutral">
                                <%= finding.category %>
                            </span>

                            <span class="badge badge-neutral">
                                <%= finding.status %>
                            </span>

                        </div>


                        <div class="finding-actions">

                            <a
                                href="/findings/<%= finding._id %>"
                                class="btn btn-sm btn-secondary"
                            >
                                View Details
                            </a>

                            <a
                                href="/remediations/<%= finding._id %>"
                                class="btn btn-sm btn-primary"
                            >
                                Fix Issue
                            </a>

                        </div>

                    </div>

                <% }); %>

            </div>

        <% } else { %>

            <div class="empty-state">

                <h3>No Medium Risk Findings</h3>

                <p>
                    No medium severity security findings are currently open.
                </p>

            </div>

        <% } %>

    </section>


    <!-- Low Findings -->
    <section class="card">

        <div class="card-header">
            <div>
                <h2>Low Risk Findings</h2>
                <p class="card-subtitle">
                    Lower priority security observations
                </p>
            </div>

            <span class="badge badge-info">
                <%= lowFindings.length %>
            </span>
        </div>


        <% if (lowFindings.length > 0) { %>

            <div class="findings-list">

                <% lowFindings.forEach(function(finding) { %>

                    <div class="finding-card">

                        <div class="finding-header">

                            <div>
                                <h3>
                                    <%= finding.title %>
                                </h3>

                                <p class="text-muted">
                                    <%= finding.device?.deviceName || "Unknown Device" %>
                                </p>
                            </div>

                            <div class="risk-score">

                                <span class="risk-score-label">
                                    Risk
                                </span>

                                <strong>
                                    <%= finding.riskScore %>
                                </strong>

                            </div>

                        </div>


                        <div class="finding-meta">

                            <span class="badge badge-info">
                                Low
                            </span>

                            <span class="badge badge-neutral">
                                <%= finding.category %>
                            </span>

                            <span class="badge badge-neutral">
                                <%= finding.status %>
                            </span>

                        </div>


                        <div class="finding-actions">

                            <a
                                href="/findings/<%= finding._id %>"
                                class="btn btn-sm btn-secondary"
                            >
                                View Details
                            </a>

                            <a
                                href="/remediations/<%= finding._id %>"
                                class="btn btn-sm btn-primary"
                            >
                                Fix Issue
                            </a>

                        </div>

                    </div>

                <% }); %>

            </div>

        <% } else { %>

            <div class="empty-state">

                <h3>No Low Risk Findings</h3>

                <p>
                    No low severity findings are currently open.
                </p>

            </div>

        <% } %>

    </section>


    <!-- Informational Findings -->
    <% if (informationalFindings && informationalFindings.length > 0) { %>

    <section class="card">

        <div class="card-header">

            <div>
                <h2>Informational Findings</h2>
                <p class="card-subtitle">
                    Informational security observations
                </p>
            </div>

            <span class="badge badge-info">
                <%= informationalFindings.length %>
            </span>

        </div>


        <div class="findings-list">

            <% informationalFindings.forEach(function(finding) { %>

                <div class="finding-card">

                    <div class="finding-header">

                        <div>
                            <h3>
                                <%= finding.title %>
                            </h3>

                            <p class="text-muted">
                                <%= finding.device?.deviceName || "Unknown Device" %>
                            </p>
                        </div>

                        <div class="risk-score">

                            <span class="risk-score-label">
                                Risk
                            </span>

                            <strong>
                                <%= finding.riskScore %>
                            </strong>

                        </div>

                    </div>


                    <div class="finding-meta">

                        <span class="badge badge-info">
                            Informational
                        </span>

                        <span class="badge badge-neutral">
                            <%= finding.category %>
                        </span>

                    </div>


                    <div class="finding-actions">

                        <a
                            href="/findings/<%= finding._id %>"
                            class="btn btn-sm btn-secondary"
                        >
                            View Details
                        </a>

                    </div>

                </div>

            <% }); %>

        </div>

    </section>

    <% } %>


    <!-- All Findings -->
    <section class="card">

        <div class="card-header">

            <div>
                <h2>All Findings</h2>
                <p class="card-subtitle">
                    Complete security finding overview
                </p>
            </div>

        </div>


        <% if (findings && findings.length > 0) { %>

        <div class="table-container">

            <table class="data-table">

                <thead>

                    <tr>
                        <th>Finding</th>
                        <th>Device</th>
                        <th>Severity</th>
                        <th>Risk Score</th>
                        <th>Category</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>

                </thead>


                <tbody>

                    <% findings.forEach(function(finding) { %>

                    <tr>

                        <td>
                            <strong>
                                <%= finding.title %>
                            </strong>
                        </td>


                        <td>
                            <%= finding.device?.deviceName || "Unknown Device" %>
                        </td>


                        <td>

                            <% if (finding.severity === "Critical") { %>

                                <span class="badge badge-danger">
                                    Critical
                                </span>

                            <% } else if (finding.severity === "High") { %>

                                <span class="badge badge-warning">
                                    High
                                </span>

                            <% } else if (finding.severity === "Medium") { %>

                                <span class="badge badge-warning">
                                    Medium
                                </span>

                            <% } else { %>

                                <span class="badge badge-info">
                                    <%= finding.severity %>
                                </span>

                            <% } %>

                        </td>


                        <td>
                            <strong>
                                <%= finding.riskScore %>
                            </strong>
                        </td>


                        <td>
                            <%= finding.category %>
                        </td>


                        <td>
                            <span class="badge badge-neutral">
                                <%= finding.status %>
                            </span>
                        </td>


                        <td>

                            <a
                                href="/findings/<%= finding._id %>"
                                class="btn btn-sm btn-secondary"
                            >
                                View
                            </a>

                        </td>

                    </tr>

                    <% }); %>

                </tbody>

            </table>

        </div>

        <% } else { %>

            <div class="empty-state">

                <h3>No Findings Available</h3>

                <p>
                    No security findings are available at the moment.
                </p>

            </div>

        <% } %>

    </section>


    <!-- Quick Actions -->
    <section class="card">

        <div class="card-header">

            <div>
                <h2>Quick Actions</h2>
                <p class="card-subtitle">
                    Continue your security analysis workflow
                </p>
            </div>

        </div>


        <div class="quick-actions">

            <a href="/security-posture" class="btn btn-secondary">
                Security Posture
            </a>

            <a href="/exposure" class="btn btn-secondary">
                Exposure Analysis
            </a>

            <a href="/drift" class="btn btn-secondary">
                Configuration Drift
            </a>

            <a href="/comparison" class="btn btn-secondary">
                Device Comparison
            </a>

            <a href="/configurations" class="btn btn-secondary">
                Configurations
            </a>

            <a href="/reports" class="btn btn-primary">
                Reports
            </a>

            <a href="/dashboard" class="btn btn-secondary">
                Dashboard
            </a>

        </div>

    </section>

</main>

<%- include("../partials/footer") %>